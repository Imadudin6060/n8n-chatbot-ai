{
  "name": "Tugas 6 - IAF",
  "nodes": [
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analisis teks email ini untuk mendeteksi tanda-tanda phishing keuangan. Fokus pada urgensi palsu, tautan mencurigakan, permintaan informasi pribadi, dan peniruan identitas bank.\n\nBeri skor bahaya dari 1 sampai 10, dengan 1 berarti sangat aman dan 10 berarti sangat berbahaya.\n\nJawab HANYA dengan format: Skor: [angka]\n\nEmail: {{ $json.snippet || $json.textPlain || $json.text || '(isi email tidak tersedia)' }}\n\nSubject: {{ $json.subject || $json.Subject || '(tanpa subjek)' }}\n\nPengirim: {{ $json.from?.value?.[0]?.address || $json.from || $json.From || 'Tidak diketahui' }}",
        "messages": {
          "messageValues": [
            {
              "message": "Anda adalah analis keamanan email. Nilai indikasi phishing berdasarkan urgensi palsu, tautan mencurigakan, permintaan informasi pribadi, dan peniruan identitas bank. Skor 1 berarti risiko rendah dan 10 berarti risiko sangat tinggi. Ikuti format output yang diminta."
            }
          ]
        },
        "batching": {}
      },
      "id": "5930a623-ab43-4893-b46c-e9baa0a50815",
      "name": "Analisa Phishing",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        3168,
        1088
      ]
    },
    {
      "parameters": {
        "jsCode": "\n/**\n * Tugas 6 - Sistem Triase Phishing AI\n * Ekstrak skor dan pertahankan ID email dari input.\n */\n\n// 1. Ambil respons AI\nconst llmOutput = String(\n  $json.text ??\n  $json.response ??\n  $json.output ??\n  $json.aiResponse ??\n  ''\n);\n\n// 2. Ekstrak skor 1-10\nconst match = llmOutput.match(/Skor\\s*:\\s*(10|[1-9])\\b/i);\nconst score = match ? Number(match[1]) : null;\n\nconst validScore =\n  Number.isInteger(score) &&\n  score >= 1 &&\n  score <= 10;\n\n// 3. Ambil ID email dari input\nconst emailMessageId =\n  $json.emailMessageId ??\n  $json.id ??\n  null;\n\n// 4. Siapkan output\nreturn {\n  json: {\n    ...$json,\n    aiResponse: llmOutput,\n    emailMessageId,\n    riskScore: validScore ? score : null,\n    scoreFound: validScore\n  }\n};\n"
      },
