    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst postsToSend = [];\n\nfor (const item of items) {\n  const row = item.json;\n  \n  // Ambil data dari kolom Google Sheet\n  const dateStr = row['Scheduled Date'];\n  const timeStr = row['Scheduled Time'];\n  const status = row['Status'];\n\n  // Kita longgarkan syaratnya: \n  // Asalkan tanggal dan waktu ada, langsung kita proses (tanpa cek Status dan tanpa cek waktu sekarang)\n  if (dateStr && timeStr) {\n    \n    // PERBAIKAN FORMAT TANGGAL:\n    // Google Sheet menggunakan format DD/MM/YYYY (contoh: 11/02/2026)\n    // Kita ubah menjadi YYYY-MM-DD agar bisa dibaca JavaScript\n    const dateParts = dateStr.split('/');\n    const formattedDate = `${dateParts[2]}-${dateParts[1]}-${dateParts[0]}`;\n    \n    // Gabungkan Tanggal dan Waktu\n    const dateTimeString = `${formattedDate}T${timeStr}`;\n    \n    // Parse waktu ke format DateTime n8n (hanya untuk validasi format, bukan untuk filter)\n    const scheduledTime = DateTime.fromISO(dateTimeString, { zone: 'Asia/Jakarta' });\n\n    // Masukkan ke output jika format tanggalnya valid\n    if (scheduledTime.isValid) {\n      postsToSend.push(item);\n    }\n  }\n}\n\nreturn postsToSend;"
      },
